# --- the mission ------------------------------------------------------------
MISSION_NAME=MARS — HABITAT ONE
# The run: 19-27 October 2026, nine days. Venue-local dates.
MISSION_START=2026-10-19
MISSION_END=2026-10-27
# Mission day and the T-clock are anchored to 00:00 in THIS timezone, never the
# visitor's. Berlin leaves summer time on 25 October, mid-run; that is handled.
MISSION_TZ=Europe/Berlin

# --- access -----------------------------------------------------------------
# There is exactly one account. It opens mission control at /control and the
# habitat terminal at /log. Any other accounts are removed on seed.
ADMIN_USER=control
ADMIN_PASSWORD=control123
# Bearer token the habitat sensors use on /api/sensors/ingest
SENSOR_TOKEN=control123
# Salt for the one-way IP hash used in rate limiting
IP_SALT=control123
# Set true when serving over HTTPS
SECURE_COOKIES=false

CONTROL_USER=control
CONTROL_PASSWORD=control123!

# --- behaviour --------------------------------------------------------------
PORT=8080
# Length of the accelerated Earth→Mars crossing, in seconds. Minimum 10.
TRANSIT_SECONDS=12
MESSAGE_MAX_CHARS=500
HOURLY_LIMIT=60
# A channel with no reading for this long shows SIGNAL LOST
SENSOR_STALE_SECONDS=300
SIM_INTERVAL=30
# Before 19 October the site is fully live and the channel accepts messages.
# Set true to hold the channel shut until the habitat is occupied.
HOLD_CHANNEL_BEFORE_LAUNCH=false
WATCH_CONTENT=true

# --- the habitat's own hardware (Home Assistant) ------------------------------
# The station polls Home Assistant's REST API on the venue network and shows
# the devices on the landing page (Habitat hardware, below the Habitat panel).
# WHICH sensors are read lives in content/home-assistant.json.
HA_HOST=localhost
HA_PORT=80
HA_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJkMDhiMGJjOTllZTI0MWZiOGFmN2JiZjA2ZDI4ZWM3ZSIsImlhdCI6MTc4ODEwNjY2OCwiZXhwIjoyMTAzNDY2NjY4fQ.Tdu4oJtSpNlCgU7SBFXwj-gUjgw6V01_g1QSvuShTMs
# How often to read, in milliseconds (minimum 15000)
HA_POLL_MS=60000
# Set false to hold the bridge off without removing the credentials
# HA_POLL=false


CLOUD_URL=https://cloud.zkm.de
CLOUD_USER=system_displays
CLOUD_PASSWORD=EW8D3-mQEHS-ekrj8-54b8w-essDZ
CLOUD_FOLDER=marsplatz
CLOUD_TITLE=Gallery
CLOUD_POLL_MS=300000