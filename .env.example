# Copy to .env and edit before the run.  docker compose reads this file.

# --- the mission ------------------------------------------------------------
MISSION_NAME=MARS — HABITAT ONE
# The run — Thursday 15 to Tuesday 27 October 2026, thirteen days, on Berlin
# time — is fixed in src/lib/run.js and is NOT read from this file, so a stale
# line here can never shorten the mission. (Mission day and the T-clock are
# anchored to 00:00 Europe/Berlin; the clock change on 25 October is handled.)
#
# To rehearse against made-up dates before the run, set all three:
# MISSION_OVERRIDE=true
# MISSION_START=2026-09-01
# MISSION_END=2026-09-13

# --- access -----------------------------------------------------------------
# There is exactly one account. It opens mission control at /control and the
# habitat terminal at /log. Any other accounts are removed on seed.
ADMIN_USER=control
ADMIN_PASSWORD=change-this-before-opening
# Bearer token the habitat sensors use on /api/sensors/ingest
SENSOR_TOKEN=generate-a-long-random-string
# Salt for the one-way IP hash used in rate limiting
IP_SALT=another-long-random-string
# Set true when serving over HTTPS
SECURE_COOKIES=false

# --- behaviour --------------------------------------------------------------
PORT=8080
# Length of the accelerated Earth→Mars crossing, in seconds. Minimum 10.
TRANSIT_SECONDS=12
MESSAGE_MAX_CHARS=500
HOURLY_LIMIT=6
# A channel with no reading for this long shows SIGNAL LOST
SENSOR_STALE_SECONDS=300
# Largest single file the crew can send out of the habitat, in MB. Files land
# in the station-data volume under /data/media, one file per SHA-256.
MEDIA_MAX_MB=4096
# Before 15 October the site is fully live and the channel accepts messages,
# which then wait for the crew. Set true to hold the channel shut until the
# habitat is occupied; the rest of the site stays visible either way.
HOLD_CHANNEL_BEFORE_LAUNCH=false
SIM_INTERVAL=30

# --- where the habitat readings start ---------------------------------------
# The node's feed hands back its last thirty days on every poll; the station
# keeps only what is stamped after its readings floor. A newly built Docker
# image (and the first start of a database) starts the readings from today;
# Reset to 15 October starts them from the first day of the run.
# READINGS_DAYS_BEFORE reaches back that many days further after a build
# (default 0). READINGS_FROM pins the floor to a date instead, whatever is
# built or reset.
READINGS_DAYS_BEFORE=0
# READINGS_FROM=2026-10-15

# --- external habitat sensor feed (critical-sensors.de) ---------------------
# The server polls this feed, stores every reading in its own database, and
# serves it to browsers at /api/habitat/data. Set CRITICAL_POLL=false to
# disable polling entirely (the dashboard then shows whatever is stored).
# CRITICAL_URL=https://critical-sensors.de/srv.php
# CRITICAL_SENSOR_ID=11
# CRITICAL_POLL_MS=1200000
# CRITICAL_MAX_DAYS=365
#
# The record closes at the end of 27 October 2026 (Berlin) — the run's last
# day. From then on nothing is updated by automation: no polling, no ingest,
# no pruning; only the final day's seal is written, once. This is fixed in
# code; CRITICAL_FREEZE_AT moves the instant for a rehearsal only.
# CRITICAL_FREEZE_AT=2026-10-27T23:59:59+01:00

# --- the cloud gallery (WebDAV) ----------------------------------------------
# Photographs kept on the ZKM cloud (Nextcloud), read over WebDAV with the
# display account and shown as a grid on /media. Read-only. The folder is a
# path inside that account (empty = its root); subfolders are followed.
# CLOUD_URL=https://cloud.zkm.de
# CLOUD_USER=system_displays
# CLOUD_PASSWORD=
# CLOUD_FOLDER=
# CLOUD_TITLE=Gallery
# Frequency: how often the folder is checked for new images, in seconds
# (minimum 5). New pictures reach every open /media within about this long.
# 1200 = every twenty minutes, the default.
# CLOUD_CHECK_SECONDS=1200
# How many pictures the pages carry: the NEWEST this many, whatever the
# folder holds beyond them (500 by default — a week of one every twenty
# minutes). Older ones stay in the folder; they are simply not shown.
# CLOUD_MAX_FILES=250000
# Set false to hold the bridge off without removing the credentials
# CLOUD_POLL=true
# Alternatively, on a machine where the cloud folder is already mounted
# (davfs2 + fstab): the directory to read instead of WebDAV. Under Docker,
# mount it into the container too (see docker-compose.yml) and name the
# path inside the container here. No user or password needed then.
# CLOUD_DIR=/cloud

# --- the habitat's own hardware (Home Assistant) ------------------------------
# The station polls Home Assistant's REST API on the venue network and shows
# the devices on the landing page (Habitat hardware, below the Habitat panel).
# WHICH sensors are read lives in content/home-assistant.json — add one there
# and it is on the station within a minute. Host, port and the long-lived
# access token live here and only here, never in the repository. Without host
# and token the bridge is off and the panel stays off the page.
# HA_HOST=192.168.0.0
# HA_PORT=80
# HA_API_TOKEN=paste-a-long-lived-home-assistant-token
# How often to read, in milliseconds (minimum 15000)
# HA_POLL_MS=60000
# Set false to hold the bridge off without removing the credentials
# HA_POLL=false
# The record closes with the run, hardware included; CRITICAL_FREEZE_AT moves
# the instant for a rehearsal, or set HA_FREEZE_AT to move only this bridge.
