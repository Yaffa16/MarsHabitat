# Copy to .env and edit before the run.  docker compose reads this file.

# --- the mission ------------------------------------------------------------
MISSION_NAME=MARS — HABITAT ONE
# The run — Thursday 15 to Tuesday 27 October 2026, thirteen days, on Berlin
# time — is fixed in src/lib/run.js and is NOT read from this file, so a stale
# line here can never shorten the mission. (Mission day and the T-clock are
# anchored to 00:00 Europe/Berlin; the clock change on 25 October is handled.)
#
# To rehearse against made-up dates before the run, set all three:
# MISSION_OVERRIDE=true
# MISSION_START=2026-09-01
# MISSION_END=2026-09-13

# --- access -----------------------------------------------------------------
# There is exactly one account. It opens mission control at /control and the
# habitat terminal at /log. Any other accounts are removed on seed.
ADMIN_USER=control
ADMIN_PASSWORD=change-this-before-opening
# Bearer token the habitat sensors use on /api/sensors/ingest
SENSOR_TOKEN=generate-a-long-random-string
# Salt for the one-way IP hash used in rate limiting
IP_SALT=another-long-random-string
# Set true when serving over HTTPS
SECURE_COOKIES=false

# --- behaviour --------------------------------------------------------------
PORT=8080
# Length of the accelerated Earth→Mars crossing, in seconds. Minimum 10.
TRANSIT_SECONDS=12
MESSAGE_MAX_CHARS=500
HOURLY_LIMIT=6
# A channel with no reading for this long shows SIGNAL LOST
SENSOR_STALE_SECONDS=300
# Largest single file the crew can send out of the habitat, in MB. Files land
# in the station-data volume under /data/media, one file per SHA-256.
MEDIA_MAX_MB=4096
# Before 15 October the site is fully live and the channel accepts messages,
# which then wait for the crew. Set true to hold the channel shut until the
# habitat is occupied; the rest of the site stays visible either way.
HOLD_CHANNEL_BEFORE_LAUNCH=false
SIM_INTERVAL=30

# --- external habitat sensor feed (critical-sensors.de) ---------------------
# The server polls this feed, stores every reading in its own database, and
# serves it to browsers at /api/habitat/data. Set CRITICAL_POLL=false to
# disable polling entirely (the dashboard then shows whatever is stored).
# CRITICAL_URL=https://critical-sensors.de/srv.php
# CRITICAL_SENSOR_ID=11
# CRITICAL_POLL_MS=1200000
# CRITICAL_MAX_DAYS=365
